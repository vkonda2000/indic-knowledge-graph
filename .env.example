# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell override values here.

# Claude API key for cited answers (Ask mode, `ikg ask`, `ikg eval --llm`)
ANTHROPIC_API_KEY=

# Admin login token for /admin (random one printed at startup if empty)
IKG_ADMIN_TOKEN=

# Optional
# IKG_CONTRIBUTOR_TOKEN=          # require a token for /contribute
# IKG_ASK_LIMIT=20                # Ask requests per hour per client for non-admins
# IKG_ASK_BUDGET_USD=5            # Ask stops for the day once estimated spend reaches this
# IKG_ANSWER_MODEL=claude-haiku-5-5   # answering model (claude-opus-5-5, claude-sonnet-5-5 also priced)
# IKG_ANSWER_EFFORT=low           # low | medium | high | xhigh | max
# IKG_ANSWER_CACHE_SIZE=1000      # repeated questions are answered from memory; 0 disables
# IKG_JUDGE_MODEL=claude-opus-5-5 # judge for ikg eval --fidelity
# IKG_UPLOAD_LIMIT=10            # contributor uploads per hour per client
# IKG_UPLOAD_GLOBAL_LIMIT=100    # contributor uploads per hour in total
# IKG_PDF_TIMEOUT=120             # seconds a PDF may take to read
# IKG_PDF_MAX_PAGES=2000          # PDFs with more pages are rejected
# IKG_SCREEN=on                   # off disables upload screening
# IKG_SCREEN_MODEL=qwen3.5:9B     # Ollama model for screening
# OLLAMA_HOST=http://127.0.0.1:11434
# IKG_DATA=data
