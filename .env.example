# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell override values here.

# Claude API key for cited answers (Ask mode, `ikg ask`, `ikg eval --llm`)
ANTHROPIC_API_KEY=

# Admin login token for /admin (random one printed at startup if empty)
IKG_ADMIN_TOKEN=

# Optional
# IKG_CONTRIBUTOR_TOKEN=          # require a token for /contribute
# IKG_ASK_LIMIT=20                # Ask requests per hour per client for non-admins
# IKG_ASK_BUDGET_USD=5            # Ask stops for the day once estimated spend reaches this
# IKG_ANSWER_MODEL=claude-haiku-5-5   # answering model (claude-opus-5-5, claude-sonnet-5-5 also priced)
# IKG_ANSWER_MODEL=ollama:qwen3.5:9B   # or a local model through Ollama: no API key, no cost
# IKG_ANSWER_EFFORT=low           # low | medium | high | xhigh | max
# IKG_ANSWER_CACHE_SIZE=1000      # repeated questions are answered from memory; 0 disables
# IKG_JUDGE_MODEL=claude-opus-5-5 # judge for ikg eval --fidelity
# IKG_UPLOAD_LIMIT=10            # contributor uploads per hour per client
# IKG_UPLOAD_GLOBAL_LIMIT=100    # contributor uploads per hour in total
# IKG_PDF_TIMEOUT=120             # seconds a PDF may take to read
# IKG_PDF_MAX_PAGES=2000          # PDFs with more pages are rejected
# IKG_EMBED=off                   # on: builds also write passage embeddings (pip install -e ".[embed]")
# IKG_EMBED_MODEL=BAAI/bge-small-en-v1.5  # fastembed model, or ollama:<model>
# IKG_MCP_TOKEN=                  # required by `ikg mcp --http` and the compose `mcp` service (16+ random characters)
# IKG_MCP_PUBLIC=off              # on: `ikg mcp --http` needs no token and leaves out ikg_ask (read-only tools
#                                 # only), for clients that can't send a static token (ChatGPT, claude.ai)
# IKG_API_TOKEN=                # optional: API clients (a custom GPT's Actions) send it as a Bearer token to Ask
#                                 # from outside the site, with their own limit (16+ random characters)
# IKG_API_ASK_LIMIT=60            # Ask calls per hour for all API-token clients together
# IKG_PUBLIC_URL=                 # the app's public https address, put in /openapi.json `servers` for GPT Actions
# IKG_VECTOR_STORE=file           # or postgresql://ikg:ikg@127.0.0.1:5433/ikg (docker compose up -d db; pip install -e ".[pg]")
# IKG_SCREEN=on                   # off disables upload screening
# IKG_SCREEN_MODEL=qwen3.5:9B     # Ollama model for screening
# OLLAMA_HOST=http://127.0.0.1:11434
# IKG_DATA=data
